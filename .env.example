PHILANTHRA_ENV=demo
DEBUG=0
# Local demo only. Production must replace both secrets and use dedicated storage.
SECRET_KEY=local-development-only-change-before-deployment
DATABASE_URL=postgresql://philanthra:philanthra-local@127.0.0.1:55432/philanthra_demo
ALLOWED_HOSTS=localhost,127.0.0.1,api
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
PHILANTHRA_LLM_PROVIDER=none
PHILANTHRA_LLM_MODEL=
# OPENAI_API_KEY is required only when explicitly enabling the optional provider.
